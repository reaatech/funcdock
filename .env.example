# Required: Strong random string (min 32 chars recommended)
JWT_SECRET=your-strong-jwt-secret-min-32-characters-long

# Required: Admin credentials for dashboard/API access.
# Supply either ADMIN_PASSWORD (hashed with bcrypt at startup) OR a pre-computed
# ADMIN_PASSWORD_HASH (generated with e.g. `node -e "console.log(require('bcryptjs').hashSync('mypassword', 10))"`).
# If both are set, ADMIN_PASSWORD_HASH wins.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password-min-8-chars
# ADMIN_PASSWORD_HASH=

# Server configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# MCP (Model Context Protocol) Server
MCP_ENABLED=true
MCP_HTTP_PORT=3001
# MCP HTTP binds to 127.0.0.1 by default. To expose externally you MUST also set MCP_API_KEY.
MCP_HTTP_HOST=127.0.0.1

# Optional: GitHub OAuth for dashboard integrations
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/oauth/github/callback

# Optional: Bitbucket OAuth for dashboard integrations
BITBUCKET_CLIENT_ID=your-bitbucket-client-id
BITBUCKET_CLIENT_SECRET=your-bitbucket-client-secret
BITBUCKET_REDIRECT_URI=http://localhost:3000/api/oauth/bitbucket/callback

# Optional: Slack webhook for alerts
SLACK_WEBHOOK_URL=

# Optional: OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=funcdock

# Optional: Deploy API key for CI/CD and CLI tools ( bypasses JWT auth for reload/status )
DEPLOY_API_KEY=

# Optional: CORS origins (comma-separated). Defaults to allowing all origins.
CORS_ORIGIN=

# Optional: Dashboard origin for Socket.IO CORS. Defaults to localhost in dev.
DASHBOARD_ORIGIN=

# Optional: Use HTTPS for internal reload requests
FUNCDOCK_SSL=false

# Optional: MCP API key for HTTP transport auth
MCP_API_KEY=

# Optional: Redis password (used in Docker setup)
REDIS_PASSWORD=funcdock_internal
